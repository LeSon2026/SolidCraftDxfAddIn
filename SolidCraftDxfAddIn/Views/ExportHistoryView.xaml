<UserControl x:Class="ExportDxfAddIn.Views.ExportHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ExportDxfAddIn.Services"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <!-- UserControl riêng cho tính năng "Lịch sử xuất" (đúng quy ước README mục 6b: 1 tính năng lớn
         = 1 UserControl riêng, không đụng layout/resources của "Xuất DXF"). Vì các Style dùng chung
         (ButtonDefault, DataGrid style...) chỉ khai báo trong Window.Resources của MainWindow.xaml
         (add-in này không có App.xaml để đặt resource toàn cục), UserControl này tự khai báo style
         riêng, tối giản, cùng bảng màu với "Xuất DXF" để đồng bộ giao diện. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="HistorySearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HistoryExportButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B9C2CE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: đồng bộ bố cục với header "Xuất DXF" (tiêu đề + phụ đề) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Nav_ExportHistory]}"
                               FontSize="15" FontWeight="Bold" Foreground="#1B2330"/>
                    <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Subtitle]}"
                               FontSize="11" Foreground="#8A93A3" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Label_Search]}"
                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5B6473" FontSize="11.5"/>
                    <TextBox Width="220" Style="{StaticResource HistorySearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="{Binding Source={x:Static loc:Tr.Instance}, Path=[Btn_ExportExcel]}"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource HistoryExportButton}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nội dung: DataGrid lịch sử hoặc trạng thái trống -->
        <Grid Grid.Row="1" Margin="10">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeaderWidth="0" Background="White"
                      BorderBrush="#DDDDDD" BorderThickness="1" AlternatingRowBackground="#FAFBFC"
                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisConverter}}">
                <!-- Ghi đè tường minh màu ô/dòng đang chọn — theme HandyControl (merge trong
                     Window.Resources của MainWindow, áp implicit lên MỌI DataGrid trong cửa sổ kể cả
                     trong UserControl con, xem README mục 6b) tô màu chọn không nhất quán giữa các
                     dòng — cùng cách MainDataGrid đã fix (MainWindow.xaml, DataGrid.CellStyle #C7EED8)
                     và LayerConfigView vừa fix. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#C7EED8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#C7EED8"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="#C7EED8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F1F3"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ExportedAtDisplay}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Header_ExportedAt]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding BatchNoDisplay}" Width="130">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Header_DxfBatchNo]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding PartNumber}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Header_PartNumber]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Revision}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Header_Revision]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Quantity}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Header_SoLuong]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Description}" Width="140">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[Header_ChieuDayVatLieu]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FileName}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Header_FileName]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding UserName}" Width="110">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Header_User]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MachineName}" Width="110">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Header_Machine]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding Source={x:Static loc:Tr.Instance}, Path=[History_Empty]}"
                           FontSize="13" Foreground="#8A93A3" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
